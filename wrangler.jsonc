{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dimiremont",
  "main": "worker/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Сторінки збирає Worker з бази; статика (стилі, фото, адмінка) — напряму з site/.
    "run_worker_first": ["/*", "!/assets/*", "!/img/*", "!/admin/*"]
  },
  // База бек-офісу (Cloudflare → Storage & Databases → D1 → dimiremont-db).
  "d1_databases": [
    { "binding": "DB", "database_name": "dimiremont-db", "database_id": "cfea4468-eccc-4e99-a190-f88d289fb4c1" }
  ],
  "observability": { "enabled": true },
  "keep_vars": true
}
